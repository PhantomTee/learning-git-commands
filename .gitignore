.vercel
# frontend/convex/_generated/ is intentionally COMMITTED: the app imports it
# and the Vercel build runs no `convex codegen` step, so ignoring it breaks
# deployment. Regenerate with `npx convex dev` and commit the result.

# Deployer private key - owner of every contract deployed with it.
deploy/.deployer.key

.vercel
.env*

# .env* above would swallow this too, and it is the only record of
# which variables the app needs. NEXT_PUBLIC_CONVEX_URL being unset is
# what produces the CONVEX FATAL ERROR on every page load.
!.env.example
